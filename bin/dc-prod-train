#!/usr/bin/env python

import os
import pickle
import argparse
import logging

import torch
import torch.optim as optim
from torch.utils.data import DataLoader

import deepclean_prod as dc
import deepclean_prod.config as config


torch.set_default_tensor_type(torch.FloatTensor)


def parse_cmd():
    parser = argparse.ArgumentParser(
        prog=os.path.basename(__file__),
        usage='%(prog)s [options]',
    )

    # Dataset
    parser.add_argument('--train-t0', type=int)
    parser.add_argument('--train-duration', type=int)
    parser.add_argument('--chanslist', type=str)
    parser.add_argument(
        '--fs',
        default=config.DEFAULT_SAMPLE_RATE,
        type=float,
    )
    parser.add_argument(
        '--train-frac',
        default=config.DEFAULT_TRAIN_FRAC,
        type=float,
    )

    # Preprocess
    parser.add_argument(
        '--filt-fl',
        default=config.DEFAULT_FLOW,
        nargs='+',
        type=float,
    )
    parser.add_argument(
        '--filt-fh',
        default=config.DEFAULT_FHIGH,
        nargs='+',
        type=float,
    )
    parser.add_argument(
        '--filt-order',
        default=config.DEFAULT_FORDER,
        type=int,
    )

    # Time-series segmentation
    parser.add_argument(
        '--train-kernel',
        default=config.DEFAULT_TRAIN_KERNEL,
        type=float,
    )
    parser.add_argument(
        '--train-stride',
        default=config.DEFAULT_TRAIN_STRIDE,
        type=float,
    )
    parser.add_argument(
        '--pad-mode',
        default=config.DEFAULT_PAD_MODE,
        type=str,
    )

    # Training
    parser.add_argument(
        '--batch-size',
        default=config.DEFAULT_BATCH_SIZE,
        type=int,
    )
    parser.add_argument(
        '--max-epochs',
        default=config.DEFAULT_MAX_EPOCHS,
        type=int,
    )
    parser.add_argument(
        '--num-workers',
        default=config.DEFAULT_NUM_WORKERS,
        type=int,
    )
    parser.add_argument(
        '--lr',
        default=config.DEFAULT_LR,
        type=float,
    )
    parser.add_argument(
        '--weight-decay',
        default=config.DEFAULT_WEIGHT_DECAY,
        type=float,
    )

    # Loss spectral settings
    parser.add_argument(
        '--fftlength',
        default=config.DEFAULT_FFT_LENGTH,
        type=float,
    )
    parser.add_argument(
        '--overlap',
        default=config.DEFAULT_OVERLAP,
        type=float,
    )
    parser.add_argument(
        '--average',
        default='mean',
        choices=['mean', 'median'],
    )

    # ----------------------------------------------------------
    # Loss weights
    #
    # These are INDEPENDENT coefficients.
    # They do NOT need to sum to 1.
    #
    # Historical baseline requested here:
    # PSD=1.0, MSE=0.0, COH=0.0, TF=0.0
    # ----------------------------------------------------------
    parser.add_argument(
        '--psd-weight',
        default=1.0,
        type=float,
    )
    parser.add_argument(
        '--mse-weight',
        default=0.0,
        type=float,
    )
    parser.add_argument(
        '--coh-weight',
        default=0.0,
        type=float,
    )
    parser.add_argument(
        '--tf-weight',
        default=0.0,
        type=float,
    )

    # Physics-loss controls
    parser.add_argument(
        '--target-coh-gate',
        default=0.05,
        type=float,
        help=(
            'Only frequencies with original target-witness coherence '
            'above this value contribute to COH/TF losses.'
        ),
    )
    parser.add_argument(
        '--channel-coh-threshold',
        default=0.03,
        type=float,
        help=(
            'Minimum band-mean target coherence used for witness '
            'channel weighting in COH/TF losses.'
        ),
    )
    parser.add_argument(
        '--loss-channel-chunk-size',
        default=8,
        type=int,
        help=(
            'Number of witness channels processed together inside '
            'COH/TF losses. This affects memory, not channel selection.'
        ),
    )

    # Timing/profile controls
    parser.add_argument(
        '--profile-loss-time',
        default=False,
        type=dc.io.str2bool,
        help=(
            'Measure PSD/MSE/COH/TF forward-computation time. '
            'CUDA synchronization makes profiling slower.'
        ),
    )
    parser.add_argument(
        '--loss-timing-warmup',
        default=5,
        type=int,
        help='Number of first criterion calls excluded from timing averages.',
    )

    # Input/output
    parser.add_argument(
        '--train-dir',
        default='.',
        type=str,
    )
    parser.add_argument(
        '--load-dataset',
        default=False,
        type=dc.io.str2bool,
    )
    parser.add_argument(
        '--save-dataset',
        default=False,
        type=dc.io.str2bool,
    )
    parser.add_argument('--log', type=str)

    # Device
    parser.add_argument(
        '--device',
        default=config.DEFAULT_DEVICE,
        type=str,
    )

    # Early stopping
    parser.add_argument(
        "--early-stopping",
        default=config.DEFAULT_EARLY_STOPPING,
        type=dc.io.str2bool,
        help="Enable validation-loss early stopping.",
    )

    parser.add_argument(
        "--early-stopping-patience",
        default=config.DEFAULT_EARLY_STOPPING_PATIENCE,
        type=int,
        help=(
            "Stop after this many consecutive epochs without "
            "a validation-loss improvement."
        ),
    )

    parser.add_argument(
        "--early-stopping-min-delta",
        default=config.DEFAULT_EARLY_STOPPING_MIN_DELTA,
        type=float,
        help=(
            "Minimum validation-loss decrease required to count "
            "as an improvement."
        ),
    )

    parser.add_argument(
        "--early-stopping-min-epochs",
        default=config.DEFAULT_EARLY_STOPPING_MIN_EPOCHS,
        type=int,
        help=(
            "Do not stop before this many epochs have completed."
        ),
    )

    return parser.parse_args()


params = parse_cmd()

# ----------------------------------------------------------------------
# Validate loss configuration
# ----------------------------------------------------------------------
weights = {
    'psd': params.psd_weight,
    'mse': params.mse_weight,
    'coh': params.coh_weight,
    'tf': params.tf_weight,
}

if any(v < 0 for v in weights.values()):
    raise ValueError('Loss weights must be non-negative')

if sum(weights.values()) <= 0:
    raise ValueError('At least one loss weight must be > 0')

# IMPORTANT:
# There is intentionally NO requirement that the weights sum to 1.

if params.early_stopping_patience < 1:
    raise ValueError('--early-stopping-patience must be >= 1')

if params.early_stopping_min_delta < 0:
    raise ValueError('--early-stopping-min-delta must be >= 0')

if params.early_stopping_min_epochs < 0:
    raise ValueError('--early-stopping-min-epochs must be >= 0')


# ----------------------------------------------------------------------
# Output/logging
# ----------------------------------------------------------------------
os.makedirs(params.train_dir, exist_ok=True)

if params.log is not None:
    params.log = os.path.join(params.train_dir, params.log)

logging.basicConfig(
    filename=params.log,
    filemode='a',
    format='%(asctime)s - %(message)s',
    level=logging.DEBUG,
)

logging.info(
    'Create training directory: {}'.format(params.train_dir)
)

logging.info(
    'Loss configuration: '
    'PSD={} MSE={} COH={} TF={} (sum={}; no normalization)'.format(
        params.psd_weight,
        params.mse_weight,
        params.coh_weight,
        params.tf_weight,
        sum(weights.values()),
    )
)

logging.info(
    'Physics-loss controls: '
    'target_coh_gate={} channel_coh_threshold={} chunk_size={}'.format(
        params.target_coh_gate,
        params.channel_coh_threshold,
        params.loss_channel_chunk_size,
    )
)

logging.info(
    'Loss timing enabled: {}'.format(params.profile_loss_time)
)

logging.info(
    'Early stopping: enabled={} patience={} min_delta={} min_epochs={}'.format(
        params.early_stopping,
        params.early_stopping_patience,
        params.early_stopping_min_delta,
        params.early_stopping_min_epochs,
    )
)


# ----------------------------------------------------------------------
# Device
# ----------------------------------------------------------------------
device = dc.nn.utils.get_device(params.device)


# ----------------------------------------------------------------------
# Datasets
# ----------------------------------------------------------------------
train_data = dc.timeseries.TimeSeriesSegmentDataset(
    params.train_kernel,
    params.train_stride,
    params.pad_mode,
)

val_data = dc.timeseries.TimeSeriesSegmentDataset(
    params.train_kernel,
    params.train_stride,
    params.pad_mode,
)


if (
    params.train_t0 is None
    and params.train_duration is None
):
    logging.info(
        'GPS time not given. Loading datasets from training directory.'
    )

    train_data.read(
        os.path.join(params.train_dir, 'training.h5'),
        params.chanslist,
    )
    val_data.read(
        os.path.join(params.train_dir, 'validation.h5'),
        params.chanslist,
    )

elif params.load_dataset:
    logging.info(
        'Loading datasets from {}'.format(params.train_dir)
    )

    train_data.read(
        os.path.join(params.train_dir, 'training.h5'),
        params.chanslist,
    )
    val_data.read(
        os.path.join(params.train_dir, 'validation.h5'),
        params.chanslist,
    )

else:
    train_t0 = params.train_t0
    train_duration = int(
        params.train_duration * params.train_frac
    )

    val_t0 = train_t0 + train_duration
    val_duration = params.train_duration - train_duration

    logging.info(
        'Fetching training data from {} to {}'.format(
            train_t0,
            train_t0 + train_duration,
        )
    )
    train_data.fetch(
        params.chanslist,
        train_t0,
        train_duration,
        params.fs,
    )

    logging.info(
        'Fetching validation data from {} to {}'.format(
            val_t0,
            val_t0 + val_duration,
        )
    )
    val_data.fetch(
        params.chanslist,
        val_t0,
        val_duration,
        params.fs,
    )

    if params.save_dataset:
        train_data.write(
            os.path.join(params.train_dir, 'training.h5')
        )
        val_data.write(
            os.path.join(params.train_dir, 'validation.h5')
        )


# ----------------------------------------------------------------------
# Preprocess
# ----------------------------------------------------------------------
logging.info('Preprocessing')

# Preserve current DeepClean behavior: bandpass the TARGET only.
train_data = train_data.bandpass(
    params.filt_fl,
    params.filt_fh,
    params.filt_order,
    'target',
)

val_data = val_data.bandpass(
    params.filt_fl,
    params.filt_fh,
    params.filt_order,
    'target',
)

mean = train_data.mean
std = train_data.std

train_data = train_data.normalize()
val_data = val_data.normalize(mean, std)


with open(
    os.path.join(params.train_dir, 'ppr.bin'),
    'wb',
) as f:
    pickle.dump(
        {
            'mean': mean,
            'std': std,
            'filt_fl': params.filt_fl,
            'filt_fh': params.filt_fh,
            'filt_order': params.filt_order,
        },
        f,
        protocol=-1,
    )


# ----------------------------------------------------------------------
# DataLoaders
# ----------------------------------------------------------------------
train_loader = DataLoader(
    train_data,
    params.batch_size,
    num_workers=params.num_workers,
    shuffle=False,
)

val_loader = DataLoader(
    val_data,
    params.batch_size,
    num_workers=params.num_workers,
    shuffle=False,
)


# ----------------------------------------------------------------------
# Model / loss / optimizer
# ----------------------------------------------------------------------
logging.info(
    'Creating neural network, loss function, optimizer, etc.'
)

model = dc.nn.net.DeepClean(
    train_data.n_channels - 1
).to(device)

logging.info(model)


criterion = dc.criterion.CompositePSDLoss(
    params.fs,
    params.filt_fl,
    params.filt_fh,
    fftlength=params.fftlength,
    overlap=params.overlap,

    psd_weight=params.psd_weight,
    mse_weight=params.mse_weight,
    coh_weight=params.coh_weight,
    tf_weight=params.tf_weight,

    reduction='sum',
    device=device,
    average=params.average,

    target_coh_gate=params.target_coh_gate,
    channel_coh_threshold=params.channel_coh_threshold,
    channel_chunk_size=params.loss_channel_chunk_size,

    enable_timing=params.profile_loss_time,
    timing_warmup=params.loss_timing_warmup,
)


optimizer = optim.Adam(
    model.parameters(),
    lr=params.lr,
    weight_decay=params.weight_decay,
)

lr_scheduler = optim.lr_scheduler.StepLR(
    optimizer,
    step_size=10,
    gamma=0.1,
)


# ----------------------------------------------------------------------
# Train
# ----------------------------------------------------------------------
train_logger = dc.logger.Logger(
    outdir=params.train_dir,
    metrics=['loss'],
)

dc.nn.utils.train(
    train_loader,
    model,
    criterion,
    optimizer,
    lr_scheduler,
    val_loader=val_loader,
    max_epochs=params.max_epochs,
    logger=train_logger,
    device=device,

    early_stopping=params.early_stopping,
    early_stopping_patience=params.early_stopping_patience,
    early_stopping_min_delta=params.early_stopping_min_delta,
    early_stopping_min_epochs=params.early_stopping_min_epochs,
)
